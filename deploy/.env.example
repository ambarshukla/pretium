# Copy to deploy/.env on the host and fill in. deploy/.env is never committed.
DB_PASSWORD=change-me
# The Docker network the host's reverse proxy (Caddy) is attached to.
PROXY_NETWORK=proxy
# Where Postgres, Kafka and the raw evidence live on the host.
PRETIUM_HOST_DATA=/opt/pretium/data
# true on the first start, so every source is collected immediately.
PRETIUM_COLLECT_ON_STARTUP=false
